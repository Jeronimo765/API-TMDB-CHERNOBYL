  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Vista movil de Chernobyl Explorer",
      "platform": "android",
      "form_factor": "narrow"
    },
    {
      "src": "./screenshots/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Vista panoramica de Chernobyl Explorer",
      "platform": "windows",
      "form_factor": "wide"
    }
  ],
  "lang": "es",
