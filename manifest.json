{
  "name": "Chernobyl Explorer",
  "short_name": "Chernobyl",
  "description": "Explorador de la serie Chernobyl con datos, episodios, reparto, galeria, videos y resenas desde TMDB.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
